config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.rust_to_llvm_obj_root = "@RUST_TO_LLVM_BINARY_DIR@"
config.rust_to_llvm_src_root = "@RUST_TO_LLVM_SOURCE_DIR@"
